[Unit]
Description=bezorg FTP/SFTP delivery downloader
Documentation=file:///usr/local/share/doc/bezorg/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bezorg
Group=bezorg

# Optional overrides. The leading '-' makes the file optional.
# EnvironmentFile=-/etc/default/bezorgd
Environment=BEZORG_STATE_DIR=/var/lib/bezorg
Environment=BEZORG_SOCKET=/run/bezorg/bezorg.sock
# Optional embedded dashboard. Leave unset to keep it disabled.
# Environment=BEZORG_WEB_LISTEN=127.0.0.1:8080

ExecStart=/usr/local/bin/bezorgd --max-jobs 2
WorkingDirectory=/var/lib/bezorg

StateDirectory=bezorg
StateDirectoryMode=0750
RuntimeDirectory=bezorg
RuntimeDirectoryMode=0700
UMask=0027

Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bezorgd

[Install]
WantedBy=multi-user.target
